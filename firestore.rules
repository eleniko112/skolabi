rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SCHOOLSYNC BOARD PROTOTYPE RULES
     * 
     * For the prototype phase, we are allowing public read/write access to school 
     * data to unblock content creation and board testing. 
     * 
     * In a production environment, 'write' access would be restricted to 
     * authenticated and authorized administrators using the isSchoolAdmin check.
     */

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    match /schools/{schoolId} {
      // Allow public access for prototype testing
      allow read, write: if true;

      match /lessons/{lessonId} {
        allow read, write: if true;
      }

      match /announcements/{announcementId} {
        allow read, write: if true;

        match /versions/{versionId} {
          allow read, write: if true;
        }
      }

      match /events/{eventId} {
        allow read, write: if true;
      }

      match /emergencyAnnouncements/active {
        allow read, write: if true;
      }

      match /adminActionLogs/{logId} {
        // Logs are readable by anyone in the prototype, but write requires a UID
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false; 
      }
    }

    match /school_admins/{schoolId}/authorizedUsers/{userId} {
      allow read, write: if true;
    }
  }
}