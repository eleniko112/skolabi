rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This rule allows anyone with your project's credentials to read and write
    // to your entire database. It is not secure and should be updated.
    // For more details, see: https://firebase.google.com/docs/firestore/security/get-started
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
